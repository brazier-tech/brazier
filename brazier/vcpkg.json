{
  "name": "brazier-core",
  "version": "0.1.6",
  "license": "LGPL-3.0-or-later",
  "description": "Modern C++ MVC framework designed for creating high-performance asynchronous APIs. The framework combines the power of Boost.Asio with modern C++20/23 features",
  "homepage": "https://github.com/brazier-tech/brazier",
  "dependencies": [
    "boost-config",
    "boost-asio",
    "boost-beast",
    "boost-system",
    "boost-thread",
    "boost-filesystem",
    "brazier-logger",
    "fmt",
    "hiredis",
    "nlohmann-json",
    "zlib",
    "openssl"
  ],
  "features": {
    "tests": {
      "description": "Build core tests",
      "dependencies": [ "gtest" ]
    }
  },
  "supports": "x64 & (windows | linux | osx)"
}
